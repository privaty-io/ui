{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".svelte-kit/output/**", "build/**"]
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "lint": {}
  }
}
