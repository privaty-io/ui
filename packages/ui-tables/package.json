{
  "name": "@privaty/ui-tables",
  "version": "0.4.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/privaty-io/ui.git",
    "directory": "packages/ui-tables"
  },
  "type": "module",
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "svelte-package && publint",
    "lint": "eslint .",
    "prepack": "pnpm build"
  },
  "files": [
    "dist",
    "NOTICE",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "!dist/**/*.fixture.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "svelte": "./src/lib/index.js",
      "default": "./src/lib/index.js"
    },
    "./*.svelte": {
      "svelte": "./src/lib/*.svelte",
      "default": "./src/lib/*.svelte"
    },
    "./*": {
      "svelte": "./src/lib/*",
      "default": "./src/lib/*"
    }
  },
  "publishConfig": {
    "access": "public",
    "types": "./dist/index.d.ts",
    "exports": {
      "./package.json": "./package.json",
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./*.svelte": {
        "types": "./dist/*.svelte.d.ts",
        "svelte": "./dist/*.svelte",
        "default": "./dist/*.svelte"
      },
      "./*": {
        "svelte": "./dist/*",
        "default": "./dist/*"
      }
    }
  },
  "peerDependencies": {
    "@privaty/ui": "workspace:^",
    "@privaty/ui-forms": "workspace:^",
    "@sveltejs/kit": "^3.0.0-next.0",
    "svelte": "^5.29.0"
  },
  "dependencies": {
    "@lucide/svelte": "catalog:",
    "@standard-schema/spec": "catalog:"
  },
  "devDependencies": {
    "@config/eslint": "workspace:*",
    "@config/typescript": "workspace:*",
    "@privaty/ui": "workspace:*",
    "@privaty/ui-forms": "workspace:*",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/package": "catalog:",
    "eslint": "catalog:",
    "publint": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:"
  }
}
